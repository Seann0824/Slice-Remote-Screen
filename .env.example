# Local host configuration. Copy this file to .env if you need persistent settings.
# The start scripts load .env automatically.

# Keep this on loopback unless you explicitly need phone/LAN access.
SLICE_HOST=127.0.0.1
SLICE_PORT=4173

# Required for non-loopback hosts. `pnpm start:lan` generates one when omitted.
# SLICE_TOKEN=replace-with-at-least-16-random-characters

# Optional overrides for packaged or development layouts.
# SLICE_NATIVE_BINARY=/absolute/path/to/SliceRemoteScreenHost.app/Contents/MacOS/slice-mac-host
# SLICE_WEB_ROOT=/absolute/path/to/apps/mobile-web/dist
# SLICE_PROFILE_PATH=/absolute/path/to/profiles.json
