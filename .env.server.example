# Required. Generate with: openssl rand -hex 32
SIGNALING_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Public origins allowed to call the signaling API/WebSocket.
SIGNALING_ALLOWED_ORIGINS=https://app.example.com

# TURN shared secret must match coturn.
TURN_SECRET=replace-with-the-same-secret-used-by-coturn
TURN_URLS=turn:turn.example.com:3478?transport=udp
TURN_EXTERNAL_IP=203.0.113.10
