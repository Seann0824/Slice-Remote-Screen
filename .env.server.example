# Public origins allowed to call the signaling API/WebSocket. Include the
# localhost origin used by the Mac Host during IP-based deployments.
SIGNALING_ALLOWED_ORIGINS=https://app.example.com,http://127.0.0.1:4173,http://localhost:4173

# TURN shared secret must match coturn.
TURN_SECRET=replace-with-the-same-secret-used-by-coturn
TURN_URLS=turn:turn.example.com:3478?transport=udp
# For a cloud VM behind NAT, use PUBLIC_IP/PRIVATE_IP (the host's real
# interface address). TURN runs with host networking so relay ports stay
# reachable from the WAN.
TURN_EXTERNAL_IP=203.0.113.10
# Optional when the host has multiple interfaces; set to its private LAN IP.
TURN_RELAY_IP=203.0.113.10
TURN_LISTENING_IP=203.0.113.10

# Published host ports. Change these if another service already owns 8787/3478.
SIGNALING_PUBLISHED_PORT=8787
TURN_PUBLISHED_PORT=3478
